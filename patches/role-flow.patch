+    if System.get_env("MOMOFLOW_ROLE_FLOW") == "1" do
+      if worker_host do
+        {:error, :role_flow_requires_local_worker}
+      else
+        SymphonyElixir.RoleRunner.run(workspace, issue,
+          PromptBuilder.build_prompt(issue, opts),
+          codex_message_handler(codex_update_recipient, issue))
