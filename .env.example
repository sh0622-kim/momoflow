MOMOFLOW_PORT=4000
# The first project is momoflow itself, using its GitHub repository.
GITHUB_REPO=sh0622-kim/momoflow
# A repository-scoped token. Keep the value only in your local .env file.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/home/your-user/.config/momoflow/secrets/github-app.pem
# Enable for GitHub App mode after filling the three settings above.
# COMPOSE_FILE=compose.yaml:compose.github-app.yaml
